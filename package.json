{
  "name": "text2ink",
  "version": "2.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate:paper-presets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-paper-presets.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:emulator": "firebase emulators:exec --project text2ink --only functions,firestore 'FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 playwright test'",
    "test:coverage": "vitest run --coverage",
    "dev:emulator": "API_URL=http://127.0.0.1:5001/text2ink/us-central1/inquiry next dev",
    "deploy": "npm run build && firebase deploy",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "inquiry-validation": "file:packages/inquiry-validation",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-modal-sheet": "^5.6.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "@playwright/test": "^1.61.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "browserslist": [
    "last 2 versions",
    "> 0.5%",
    "not dead",
    "not ie 11"
  ]
}
